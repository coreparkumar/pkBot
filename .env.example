# OpenRouter API credentials used by the server-side /api/chat endpoint.
# Copy this file to .env locally and add your key. Never expose it in frontend code.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional: needed only for the existing Gemini audio transcription fallback.
GEMINI_API_KEY=

# APP_URL: Optional URL where this applet is hosted.
APP_URL="MY_APP_URL"
